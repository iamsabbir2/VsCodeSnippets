	"Print to console": {
		"scope": "cpp",
		"prefix": "circular_subarray_sum",
		"body": [
			"int circularSubarraySum(vector<int> &arr)",
			"{",
			"\tint n = arr.size();",
			"\tint suffixSum = arr[n - 1];",
			"\tvector<int> maxSuffix(n + 1, 0);",
			"\tmaxSuffix[n - 1] = arr[n - 1];",
			"\tfor (int i = n - 2; i >= 0; i--)",
			"\t{",
			"\t\tsuffixSum = suffixSum + arr[i];",
			"\t\tmaxSuffix[i] = max(maxSuffix[i + 1], suffixSum);",
			"\t}",
			"\tint circularSum = arr[0];",
			"\tint normalSum = arr[0];",
			"\tint currSum = 0;",
			"\tint prefix = 0;",
			"\tfor (int i = 0; i < n; i++)",
			"\t{",
			"\t\tcurrSum = max(currSum + arr[i], arr[i]);",
			"\t\tnormalSum = max(normalSum, currSum);",
			"\t\tprefix = prefix + arr[i];",
			"\t\tcircularSum = max(circularSum, prefix + maxSuffix[i + 1]);",
			"\t}",
			"\treturn max(circularSum, normalSum);",
			"}"
		],
		"description": "Log output to console"
	}
}
			"{",
			"\tif (l == r)",
			"\t{",
			"\t\tfor (int num : arr)",
			"\t\t\tcout << num << \" \";",
			"\t\tcout << endl;",
			"\treturn;",
			"\t}",
			"\tfor (int i = l; i <= r; i++)",
